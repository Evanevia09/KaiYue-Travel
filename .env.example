# Copy to apps/web/.dev.vars for local Wrangler/workerd development.
# Never commit live secrets. Placeholder values only.

# Runtime
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:4321
BUSINESS_TIMEZONE=Asia/Macau
BOOKING_NOTICE_HOURS=24

# D1 is bound in wrangler.jsonc. Local database_id is a placeholder.

# Cloudflare Email Service via the `EMAIL` send_email binding (no API key).
# Mail is sent only when NOTIFICATIONS_ENABLED is exactly "true", the binding
# exists, and PUBLIC_SITE_URL is the production site or the staging site with a
# non-empty NOTIFY_ALLOWED_RECIPIENTS lock. Bookings persist either way.
NOTIFICATIONS_ENABLED=false
NOTIFY_FROM_EMAIL=notifications@example.invalid
NOTIFY_FROM_NAME=Kai Yue Travel
NOTIFY_STAFF_TO=ops@example.invalid
NOTIFY_ALLOWED_RECIPIENTS=

# Cloudflare Access — empty values fail closed in non-development environments
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Local/admin only. Ignored unless ENVIRONMENT=development.
DEV_ADMIN_BYPASS=true
