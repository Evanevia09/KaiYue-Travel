# Copy to apps/web/.dev.vars for local Wrangler/workerd development.
# Never commit live secrets. Placeholder values only.

# Runtime
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:4321
BUSINESS_TIMEZONE=Asia/Macau
BOOKING_NOTICE_HOURS=24

# D1 is bound in wrangler.jsonc. Local database_id is a placeholder.

# Resend — leave empty to stub notifications (booking still persists)
RESEND_API_KEY=
RESEND_FROM=Kai Yue Travel <notifications@example.invalid>
RESEND_STAFF_TO=ops@example.invalid
RESEND_REPLY_TO=

# Cloudflare Access — empty values fail closed on non-local surfaces
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Loopback admin only. Ignored unless the request host is localhost/127.0.0.1
# AND ENVIRONMENT=development (or local). Production, staging, Access, and any
# other public host ignore this flag even if ENVIRONMENT=development.
DEV_ADMIN_BYPASS=true

# Temporary allowlisted password admin (never commit live values).
# Non-local password login also requires a future TEMP_ADMIN_EXPIRES_AT.
# BETTER_AUTH_SECRET signs session cookies. It is not used by hashPassword.
# ADMIN_SETUP_TOKEN is loopback signup only; public hosts 404 even when
# ENVIRONMENT=development and the token is present.
# BETTER_AUTH_SECRET=
# ADMIN_EMAILS=
# TEMP_ADMIN_EXPIRES_AT=
# ADMIN_SETUP_TOKEN=
