// Sanitized STAGING upload config for kaiyue-travel-staging on account 33ecc only.
// Supersedes overlay sha256 11ead30e9c3afa33e333027eb2850a40b50c815792e3e225458584d98d9c0bb6
// (that overlay belonged to frozen fa5184c / zip b5b0be97…). Do not upload that
// overlay with this runtime.
//
// DOCUMENTED DELTAS vs the in-ZIP wrangler.jsonc:
//   - account_id pinned to 33ecc75158a1cdd23ba1a62eb70c5103 (do not use 41386f)
//   - no_bundle + keep_vars (CLI flags still required)
//   - workers_dev: true, preview_urls: false
//   - assets.run_worker_first: true  REQUIRED so admin-host middleware runs.
//   - ADMIN_STAGING_TEST_PASSWORD_MIN=6 (staging workers.dev UAT only)
//   - ADMIN_EMAILS planned operator delta: Daniel + synthetic UAT address.
//     Git wrangler env.staging still lists Daniel only. Live allowlist is not
//     changed until this overlay is uploaded. Do not commandeer Daniel.
//
// Secrets are omitted. --keep-vars preserves live BETTER_AUTH_SECRET.
// Do not add --env, --secrets-file, or wrangler deploy.
// This file is for versions upload only after Mika review. No upload here.
{
  "name": "kaiyue-travel-staging",
  "account_id": "33ecc75158a1cdd23ba1a62eb70c5103",
  "main": "./entry.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist-client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaiyue-travel-staging",
      "database_id": "043cd0ff-a1e6-4b5e-98c1-968c286e0c70",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OFFERS_BUCKET",
      "bucket_name": "kaiyue-offers-staging"
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview",
    "PUBLIC_SITE_URL": "https://kaiyue-travel-staging.kai-yue.workers.dev",
    "BUSINESS_TIMEZONE": "Asia/Macau",
    "BOOKING_NOTICE_HOURS": "24",
    "WHATSAPP_NUMBER": "+85328338882",
    "DEV_ADMIN_BYPASS": "false",
    "ADMIN_EMAILS": "daniel@kaiyuemacau.com,uat-admin-20261114@kaiyue.test",
    "TEMP_ADMIN_EXPIRES_AT": "2026-11-24T15:59:59+08:00",
    "ADMIN_STAGING_TEST_PASSWORD_MIN": "6"
  }
}
