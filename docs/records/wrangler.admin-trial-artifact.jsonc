{
  "name": "kaiyue-travel-admin-trial",
  "account_id": "33ecc75158a1cdd23ba1a62eb70c5103",
  "main": "./entry.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "keep_vars": false,
  "assets": {
    "directory": "./dist-client",
