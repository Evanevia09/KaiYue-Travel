{
  // Fail-closed repository-root config. It must never deploy anywhere real.
  //
  // Deploys use only the named, guarded overlays:
  //   deploy/official-staging/wrangler.jsonc  (official-staging CI/CD)
  //   deploy/production/wrangler.jsonc        (reviewed production release)
  //
  // This file has a non-production Worker name, a placeholder account id that
  // no Cloudflare token can write to, no D1/R2 bindings, no vars, and no
  // previews block. A bare `wrangler deploy`, `wrangler versions upload`, or a
  // leftover Workers Builds connection against the repo root therefore cannot
  // update `kaiyue-travel` or bind any retired, staging, or production data.
  // `--dry-run` bundling from Astro dist still works.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaiyue-root-config-disabled",
  "account_id": "00000000000000000000000000000000",
  "main": "./apps/web/dist/server/entry.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/web/dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
