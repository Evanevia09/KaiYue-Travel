// Official staging upload overlay. Generated from deploy/official-staging/constants.json.
// Do not upload git wrangler.jsonc. keep_vars false. Secrets omitted (Worker-only).
// HTML Worker-first. This file does not deploy traffic by itself.
{
  "name": "kaiyue-travel-staging",
  "account_id": "33ecc75158a1cdd23ba1a62eb70c5103",
  "main": "../../apps/web/dist/server/entry.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": false,
  "assets": {
    "directory": "../../apps/web/dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/images/*",
      "!/favicon.ico"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaiyue-travel-staging",
      "database_id": "043cd0ff-a1e6-4b5e-98c1-968c286e0c70",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OFFERS_BUCKET",
      "bucket_name": "kaiyue-offers-staging"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_SITE_URL": "https://staging.kaiyuemacau.com",
    "BUSINESS_TIMEZONE": "Asia/Macau",
    "BOOKING_NOTICE_HOURS": "24",
    "WHATSAPP_NUMBER": "+85328338882",
    "DEV_ADMIN_BYPASS": "false",
    "ADMIN_STAGING_TEST_PASSWORD_MIN": "6",
    "ADMIN_EMAILS": "daniel@kaiyuemacau.com,uat-admin-20261114@kaiyue.test,scalingsmb@gmail.com"
  }
}
