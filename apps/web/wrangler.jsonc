{
  // Local dev / getPlatformProxy only. Astro build copies this into
  // dist/server/wrangler.json and a .wrangler/deploy redirect, so it must stay
  // non-deployable: disabled name, placeholder account, local-only D1/R2 ids.
  // Real deploys use deploy/official-staging or deploy/production overlays.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaiyue-local-dev-disabled",
  "account_id": "00000000000000000000000000000000",
  "workers_dev": false,
  "preview_urls": false,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaiyue-local-dev",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OFFERS_BUCKET",
      "bucket_name": "kaiyue-offers-local-dev",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_SITE_URL": "http://localhost:4321",
    "BUSINESS_TIMEZONE": "Asia/Macau",
    "BOOKING_NOTICE_HOURS": "24",
    "NOTIFICATIONS_ENABLED": "false",
    "NOTIFY_FROM_EMAIL": "notifications@example.invalid",
    "NOTIFY_FROM_NAME": "Kai Yue Travel",
    "NOTIFY_STAFF_TO": "ops@example.invalid",
    "WHATSAPP_NUMBER": "+85328338882",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_ADMIN_BYPASS": "false",
  },
}
