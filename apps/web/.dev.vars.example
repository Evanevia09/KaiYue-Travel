ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:4321
BUSINESS_TIMEZONE=Asia/Macau
BOOKING_NOTICE_HOURS=24
RESEND_API_KEY=
RESEND_FROM=Kai Yue Travel <notifications@example.invalid>
RESEND_STAFF_TO=ops@example.invalid
RESEND_REPLY_TO=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Loopback + ENVIRONMENT=development only. Ignored on public hosts.
DEV_ADMIN_BYPASS=false
# Session cookie signing. Not used by hashPassword.
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
# Loopback signup only. Public hosts 404 even with ENVIRONMENT=development.
ADMIN_SETUP_TOKEN=
TEMP_ADMIN_EXPIRES_AT=
