---
import FeatureIcon from "./FeatureIcon.astro";
import type { ServiceRecord } from "../../lib/site.ts";

type Props = { service: ServiceRecord };
const { service } = Astro.props;
const isHourly = service.serviceType === "hourly_charter";
---

<section class="section editorial-section" aria-labelledby="service-overview">
  <div class:list={["wrap", "editorial-split", { "editorial-split--reverse": isHourly }]}>
    <div class="editorial-photo">
      <img
        src={service.featuredImage}
        width="860"
        height="400"
        loading="lazy"
        alt={service.featuredImageAlt}
      />
    </div>
    <div class="editorial-copy">
      <p class="kicker">
        {isHourly ? "By the hour" : "Point to point"}
      </p>
      <h2 id="service-overview">{service.overviewHeading}</h2>
      <p class="lede">{service.intro}</p>
      <div class="feature-lines">
        {
          service.whoFor.slice(0, 2).map((item, index) => (
            <div>
              <>
                <span class="icon-frame">
                  <FeatureIcon name={index === 0 ? (isHourly ? "clock" : "route") : "check"} />
                </span>
                <p>{item}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section section--muted" aria-labelledby="service-process">
  <div class="wrap">
    <div class="section-intro">
      <div>
        <p class="kicker">Journey ideas</p><h2 id="service-process">
          {service.detailsHeading}
        </h2>
      </div><p>{service.description}</p>
    </div>
    <div class="process-grid process-grid--light">
      {
        service.process.map((item, index) => (
          <article>
            <>
              <span class="icon-frame">
                <FeatureIcon
                  name={
                    index === 0 ? (isHourly ? "clock" : "route") : index === 1 ? "message" : "check"
                  }
                />
              </span>
              <span class="process-grid__number">0{index + 1}</span>
              <h3>{service.useCases[index]}</h3>
              <p>{item}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
