---
import HeroBackdrop from "./HeroBackdrop.astro";

type Props = {
  eyebrow?: string;
  title: string;
  lede?: string;
  imageSrc?: string;
  imageAlt?: string;
};

const { eyebrow, title, lede, imageSrc, imageAlt } = Astro.props;
---

<section class="hero hero--page">
  <HeroBackdrop src={imageSrc} alt={imageAlt} />
  <div class="hero__stage">
    {eyebrow ? <p class="kicker">{eyebrow}</p> : null}
    <h1>{title}</h1>
    {lede ? <p class="hero-sub">{lede}</p> : null}
    {
      Astro.slots.has("actions") ? (
        <div class="hero__actions">
          <slot name="actions" />
        </div>
      ) : null
    }
    <slot />
  </div>
</section>
