---
import { BookingEmbedded } from "../booking/BookingEmbedded.tsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeFromPath } from "../../lib/i18n.ts";
import { specialOfferUi } from "../../lib/special-offer-copy.ts";
import PageHero from "./PageHero.astro";

type OfferPhoto = {
  id: string;
  url: string;
  thumbUrl?: string;
  isMain: boolean;
  width?: number | null;
  height?: number | null;
};

type OfferItem = {
  id: string;
  title: string;
  description: string;
  priceFrom: number | null;
  terms: string;
  photos: OfferPhoto[];
  mainPhotoUrl: string | null;
};

type Props = { offer: OfferItem; publishedOffers?: Array<{ id: string; title: string }> };
const { offer, publishedOffers } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const copy = specialOfferUi(locale);
const photos = [...offer.photos].sort((a, b) => Number(b.isMain) - Number(a.isMain));
const heroSrc = offer.mainPhotoUrl ?? photos[0]?.url ?? "/images/illustrative/city-tours-hero.jpg";
const widgetOffers = publishedOffers?.length
  ? publishedOffers
  : [{ id: offer.id, title: offer.title }];
const seoDescription =
  offer.description.length > 180 ? `${offer.description.slice(0, 177).trim()}…` : offer.description;
---

<BaseLayout
  title={offer.title}
  description={seoDescription}
  ogImage={heroSrc}
  preserveMetadata={true}
  bookingEnabled={true}
  showMobileBook={false}
  specialOffers={widgetOffers}
>
  <PageHero
    id="offer-hero"
    className="hero--tour-package"
    title={offer.title}
    lede={offer.description}
    imageSrc={heroSrc}
    imageAlt={offer.title}
    preserveCopy={true}
  >
    <BookingEmbedded
      slot="booking"
      client:only="react"
      sourcePage={Astro.url.pathname}
      enquiryKind="special_offer"
      tourPackageId={offer.id}
      tourPackageTitle={offer.title}
    />
  </PageHero>
  <section class="section product" aria-labelledby="product-title" data-no-localize>
    <div class="wrap product__grid">
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__stage">
          <img
            data-gallery-main
            src={photos[0]?.url ?? heroSrc}
            alt={offer.title}
            width={photos[0]?.width ?? 1200}
            height={photos[0]?.height ?? 900}
            decoding="async"
          />
        </div>
        {
          photos.length > 1 && (
            <div class="product-gallery__thumbs" role="group" aria-label={copy.photos}>
              {photos.map((photo, index) => (
                <button
                  type="button"
                  data-gallery-thumb
                  data-src={photo.url}
                  data-alt={offer.title}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-label={`${copy.showPhoto} ${index + 1}`}
                >
                  <img
                    src={photo.thumbUrl ?? photo.url}
                    alt=""
                    width="240"
                    height="160"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>
      <div class="product__info">
        <p class="product__fact">{copy.serviceValue}</p>
        <h2 id="product-title">{offer.title}</h2>
        {
          offer.priceFrom != null && (
            <div class="product-price">
              <p class="product-price__label">{copy.from}</p>
              <p class="product-price__value">{offer.priceFrom}</p>
            </div>
          )
        }
        <h3>{copy.descriptionHeading}</h3>
        <p class="product__description">{offer.description}</p>
        {
          offer.terms ? (
            <>
              <h3>{copy.terms}</h3>
              <p class="product__description">{offer.terms}</p>
            </>
          ) : null
        }
        <a class="btn btn--primary product-book" href="#offer-hero">{copy.book}</a>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  function bindProductGalleries() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-product-gallery]")) {
      if (root.dataset.ready === "true") continue;
      root.dataset.ready = "true";
      const main = root.querySelector<HTMLImageElement>("[data-gallery-main]");
      const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const src = button.dataset.src;
          if (!main || !src) return;
          main.src = src;
          main.alt = button.dataset.alt ?? "";
          for (const item of buttons)
            item.setAttribute("aria-pressed", item === button ? "true" : "false");
        });
      }
    }
  }
  bindProductGalleries();
  document.addEventListener("astro:page-load", bindProductGalleries);
</script>
<style>
  :global(.hero--tour-package) {
    min-height: 68svh;
  }
  .product__grid {
    display: grid;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .product-gallery__stage {
    overflow: hidden;
    border: 1px solid #e6e6e6;
    border-radius: 0.4rem;
    background: #f6f6f6;
    aspect-ratio: 1 / 1;
  }
  .product-gallery__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__thumbs {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
  }
  .product-gallery__thumbs button {
    flex: 0 0 4.75rem;
    width: 4.75rem;
    height: 4.75rem;
    overflow: hidden;
    padding: 0;
    border: 1px solid #d0d0d0;
    border-radius: 0.35rem;
    background: #f6f6f6;
    cursor: pointer;
  }
  .product-gallery__thumbs button[aria-pressed="true"] {
    border: 2px solid #111;
  }
  .product-gallery__thumbs button:focus-visible {
    outline: 3px solid #008c5e;
    outline-offset: 3px;
  }
  .product-gallery__thumbs img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__fact {
    margin: 0 0 0.45rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .product__info h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .product-price {
    margin: 1.35rem 0 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e6e6e8;
  }
  .product-price__label {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .product-price__value {
    margin: 0.2rem 0 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .product__info h3 {
    margin: 0 0 0.55rem;
    font-size: 1.05rem;
  }
  .product__description {
    margin: 0 0 1.75rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .product-book.btn--primary {
    width: 100%;
    margin-top: 1.75rem;
    background: var(--booking-green-gradient);
    color: #000;
  }
  .product-book.btn--primary:hover {
    background: var(--booking-green-gradient-hover);
    color: #000;
  }
  @media (min-width: 900px) {
    .product__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    }
    .product-gallery {
      position: sticky;
      top: calc(var(--header-height) + 1rem);
      flex-direction: row;
      align-items: flex-start;
    }
    .product-gallery__thumbs {
      flex-direction: column;
      order: -1;
      overflow: visible;
    }
  }
</style>
