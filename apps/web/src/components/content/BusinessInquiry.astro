---
import { ContactForm } from "./ContactForm.tsx";
import { localeFromPath } from "../../lib/i18n.ts";

type Props = {
  sourcePage: string;
  heading?: string;
};

const { sourcePage, heading = "Request a programme" } = Astro.props;
const isLocalized = localeFromPath(Astro.url.pathname) !== "en";
---

<div class="card" id="inquiry">
  <h2>{heading}</h2>
  {
    isLocalized ? (
      <ContactForm client:only="react" sourcePage={Astro.url.pathname} defaultType="corporate" />
    ) : (
      <ContactForm client:load sourcePage={sourcePage} defaultType="corporate" />
    )
  }
</div>
