---
/**
 * Shared WeChat QR entry for the footer and contact page.
 * Uses the owner-supplied JPEG bytes without regeneration.
 * Do not invent a WeChat ID.
 */
export const WECHAT_QR_SRC = "/images/wechat-qr.jpg";
export const WECHAT_QR_WIDTH = 774;
export const WECHAT_QR_HEIGHT = 784;

type Props = {
  variant?: "footer" | "page";
};

const { variant = "page" } = Astro.props;
---

<figure class:list={["wechat-qr", `wechat-qr--${variant}`]}>
  <div class="wechat-qr__frame">
    <img
      src={WECHAT_QR_SRC}
      width={WECHAT_QR_WIDTH}
      height={WECHAT_QR_HEIGHT}
      alt="WeChat QR code"
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption class="wechat-qr__caption">WeChat</figcaption>
</figure>
