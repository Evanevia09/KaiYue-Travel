---
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import { BookingSheet } from "../components/booking/BookingSheet.tsx";
import { nav, site } from "../lib/site.ts";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
};

const { title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href="/">
          <span class="logo-mark" aria-hidden="true">凱</span>
          <span class="logo-text">
            <strong>KAI YUE</strong>
            <span>TRAVEL · {site.chineseName}</span>
          </span>
        </a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <BookingLauncher client:load sourcePage={path} sourceTrigger="header" />
          <details class="mobile-nav">
            <summary class="btn btn--ghost" aria-label="Open menu">Menu</summary>
            <nav class="mobile-nav__panel" aria-label="Mobile">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={path.startsWith(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <div class="mobile-book">
      <BookingLauncher
        client:load
        sourcePage={path}
        sourceTrigger="mobile-persistent"
        label="Book now"
      />
    </div>
    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <a class="logo" href="/">
            <span class="logo-mark" aria-hidden="true">凱</span>
            <span class="logo-text">
              <strong>KAI YUE</strong>
              <span>TRAVEL · {site.chineseName}</span>
            </span>
          </a>
          <p>{site.chineseName}</p>
          <p class="draft-note">
            Visual system matched to the homepage mocks. License, fleet, and commercial claims
            remain unverified.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/services">Services</a></li>
            <li><a href="/fleet">Fleet</a></li>
            <li><a href="/booking">Book now</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/corporate">Corporate</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <p>
            <a href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a>
          </p>
          <p>{site.addressLines.join(", ")}</p>
        </div>
      </div>
    </footer>
    <BookingSheet client:load />
  </body>
</html>
