---
import { getCollection } from "astro:content";
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import { BookingSheet } from "../components/booking/BookingSheet.tsx";
import { localeFromPath, localeNames, localePath, localeTags, stripLocale } from "../lib/i18n.ts";
import { footerServiceGroups, nav, site } from "../lib/site.ts";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
  showMobileBook?: boolean;
  bookingEnabled?: boolean;
  ogImage?: string;
  preserveMetadata?: boolean;
};

const {
  title,
  description = site.description,
  noindex = false,
  showMobileBook = true,
  bookingEnabled = false,
  ogImage = site.defaultOgImage,
  preserveMetadata = false,
} = Astro.props;
const origin = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImageUrl = new URL(ogImage, origin).toString();
const locale = localeFromPath(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname);
const isHome = path === "/";
const tourPackages = bookingEnabled
  ? (await getCollection("cityTours", ({ data }) => data.status !== "hidden"))
      .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
      .map(({ id, data }) => {
        const translation = locale === "en" ? data : (data.translations?.[locale] ?? data);
        return {
          id,
          title: translation.title,
          durationHours: data.durationHours ?? null,
        };
      })
  : [];

function isCurrent(href: string) {
  return href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
}

function isSectionCurrent(item: (typeof nav)[number]) {
  if ("children" in item && item.children) {
    return item.children.some((child) => isCurrent(child.href));
  }
  return Boolean("href" in item && item.href && isCurrent(item.href));
}
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/mark.svg" type="image/svg+xml" />
    <title data-no-localize={preserveMetadata || undefined}>{title} · {site.name}</title>
    <meta
      name="description"
      content={description}
      data-no-localize={preserveMetadata || undefined}
    />
    <link rel="canonical" href={canonical} />
    {
      (["en", "pt", "zh-Hant"] as const).map((language) => (
        <link
          rel="alternate"
          hreflang={localeTags[language]}
          href={new URL(localePath(path, language), origin).toString()}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(path, origin).toString()} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta
      property="og:title"
      content={`${title} · ${site.name}`}
      data-no-localize={preserveMetadata || undefined}
    />
    <meta
      property="og:description"
      content={description}
      data-no-localize={preserveMetadata || undefined}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTags[locale]} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    {
      bookingEnabled && (
        <script is:inline define:vars={{ tourPackages }}>
          window.__KY_TOUR_PACKAGES = tourPackages;
        </script>
      )
    }
  </head>
  <body class:list={{ "page-no-mobile-book": !showMobileBook, "page-home": isHome }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href="/">
          <img
            class="logo-image"
            src={site.logo}
            alt="Kai Yue Travel Group"
            width="1500"
            height="294"
          />
        </a>
        <nav class="nav nav--pill" aria-label="Primary">
          {
            nav.map((item) =>
              "children" in item && item.children ? (
                <details class="nav-dropdown">
                  <summary class:list={{ "is-current": isSectionCurrent(item) }}>
                    {item.label}
                  </summary>
                  <ul class="nav-dropdown__menu">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          aria-current={isCurrent(child.href) ? "page" : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={"href" in item ? item.href : "/"}
                  aria-current={
                    "href" in item && item.href && isCurrent(item.href) ? "page" : undefined
                  }
                >
                  {item.label}
                </a>
              ),
            )
          }
          <a href="/about" aria-current={isCurrent("/about") ? "page" : undefined}>About Us</a>
        </nav>
        <div class="header-actions">
          <details class="lang-switch">
            <summary aria-label={`Language, ${localeNames[locale]}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle>
                <path
                  d="M3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9S14.5 18.2 12 21c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3Z"
                  stroke="currentColor"
                  stroke-width="1.75"></path>
              </svg>
              {locale === "en" ? "EN" : locale === "pt" ? "PT" : "繁"}
            </summary>
            <ul class="lang-switch__menu">
              <li>
                <a
                  href={localePath(path, "en")}
                  hreflang="en"
                  lang="en"
                  aria-current={locale === "en" ? "true" : undefined}>English</a
                >
              </li>
              <li>
                <a
                  href={localePath(path, "pt")}
                  hreflang="pt-PT"
                  lang="pt-PT"
                  aria-current={locale === "pt" ? "true" : undefined}>Português</a
                >
              </li>
              <li>
                <a
                  href={localePath(path, "zh-Hant")}
                  hreflang="zh-Hant"
                  lang="zh-Hant"
                  aria-current={locale === "zh-Hant" ? "true" : undefined}>繁體中文</a
                >
              </li>
            </ul>
          </details>
          <a
            class="header-chip"
            href={`https://wa.me/${site.phone.replaceAll(/\D/g, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="General enquiry on WhatsApp"
          >
            <span class="header-chip__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path
                  d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linejoin="round"></path>
                <path
                  d="M8.7 8.2c.5 2.7 2.4 4.6 5.1 5.1l1.2-1.2c.2-.2.5-.3.8-.1l1.7.8c.3.1.4.4.4.7-.1 1.1-1 2-2.1 2.1-4.5.3-7.9-3.1-7.6-7.6.1-1.1 1-2 2.1-2.1.3 0 .6.1.7.4l.8 1.7c.1.3.1.6-.1.8L10.5 10"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"></path>
              </svg>
            </span>
            General Enquiry
          </a>
          <details class="mobile-nav">
            <summary class="menu-toggle" aria-label="Site menu">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </summary>
            <nav class="mobile-nav__panel" aria-label="Mobile">
              {
                nav.map((item) =>
                  "children" in item && item.children ? (
                    <details class="mobile-nav__group">
                      <summary
                        class:list={[
                          "mobile-nav__toggle",
                          { "is-current": isSectionCurrent(item) },
                        ]}
                      >
                        {item.label}
                      </summary>
                      <div class="mobile-nav__submenu">
                        {item.children.map((child) => (
                          <a
                            href={child.href}
                            aria-current={isCurrent(child.href) ? "page" : undefined}
                          >
                            {child.label}
                          </a>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <a
                      href={"href" in item ? item.href : "/"}
                      aria-current={
                        "href" in item && item.href && isCurrent(item.href) ? "page" : undefined
                      }
                    >
                      {item.label}
                    </a>
                  ),
                )
              }
              <a
                class="mobile-nav__about"
                href="/about"
                aria-current={isCurrent("/about") ? "page" : undefined}>About Us</a
              >
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {
      bookingEnabled && showMobileBook ? (
        <div class="mobile-book">
          <BookingLauncher
            client:load
            sourcePage={Astro.url.pathname}
            sourceTrigger="mobile-persistent"
            label="Book now"
          />
        </div>
      ) : null
    }
    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <a class="logo" href="/">
            <img
              class="logo-image"
              src={site.logo}
              alt="Kai Yue Travel Group"
              width="1500"
              height="294"
            />
          </a>
          <p>{site.legalName}</p>
          <p class="draft-note">
            Private bookings on this site are Macau chauffeur requests, quoted after review.
            Corporate, hotel, and agency programmes follow the Kai Yue Group portfolio.
          </p>
          <p>
            <a href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a>
          </p>
          <p>{site.addressLines.join(", ")}</p>
        </div>
        <div>
          <h2>Services</h2>
          <div class="site-footer__groups">
            {
              footerServiceGroups.map((group) => (
                <div class="site-footer__group">
                  <h3>{group.label}</h3>
                  <ul>
                    {group.children.map((item) => (
                      <li>
                        <a href={item.href}>{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
        <div>
          <h2>B2B Solution</h2>
          <ul>
            <li><a href="/business/hotels-resorts">Hotels &amp; Resorts</a></li>
            <li><a href="/business/travel-agency">Travel Agency</a></li>
            <li><a href="/corporate">Corporate Solutions</a></li>
          </ul>
        </div>
      </div>
    </footer>
    {bookingEnabled ? <BookingSheet client:only="react" /> : null}
    <script>
      import "../scripts/header-menus.ts";
    </script>
    <script>
      import "../scripts/localize-islands.ts";
    </script>
  </body>
</html>
