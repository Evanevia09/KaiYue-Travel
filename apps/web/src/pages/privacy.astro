---
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy"
  description="Draft privacy notice. Legal text requires owner approval before launch."
>
  <PageHero
    eyebrow="Legal"
    title="Privacy"
    lede="Draft only. Not approved legal text."
  />
  <article class="section">
    <div class="wrap prose">
      <p>
        Booking and inquiry forms collect the contact and journey details needed to review a request.
        Records are stored so staff can follow up. Email delivery, when configured, is a notification
        side effect and is not the source of truth.
      </p>
      <p>Retention, deletion, and lawful-basis wording will be added after legal review.</p>
    </div>
  </article>
</BaseLayout>
