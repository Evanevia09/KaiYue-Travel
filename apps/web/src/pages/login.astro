---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in"
  description="Customer accounts are not open in this release. You can still request a chauffeur without signing in."
  noindex
  showMobileBook={false}
>
  <section class="section page-content" aria-labelledby="account-title">
    <div class="wrap page-content__narrow">
      <p class="kicker">Account</p>
      <h1 id="account-title">Sign in is unavailable</h1>
      <p>
        Customer accounts are not available in this release. You can request a journey through a
        chauffeur service page without creating an account.
      </p>
      <p><a href="/">Return home</a> · <a href="/contact">Contact us</a></p>
    </div>
  </section>
</BaseLayout>
