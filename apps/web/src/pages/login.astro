---
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in"
  description="Customer accounts are not open in this release. You can still request a chauffeur without signing in."
  noindex
  showMobileBook={false}
>
  <PageHero
    eyebrow="Account"
    title="Sign in"
    lede="Customer accounts are not available in this release. You can request a private chauffeur without creating an account."
  />
  <section class="section">
    <div class="wrap" style="max-width: 36rem;">
      <div class="card">
        <h2>No account needed for a request</h2>
        <p>
          Sign-in will sit here when customer accounts are approved. Until then, submit a booking
          request; a person confirms availability before any trip is treated as booked.
        </p>
        <p>
          <BookingLauncher client:load sourcePage="/login" sourceTrigger="login-card" />
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
