---
import { ContactForm } from "../components/content/ContactForm.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site.ts";
---

<BaseLayout
  title="Contact"
  description="Send a general inquiry or request a chauffeur through the booking form."
>
  <section class="wrap section grid-2">
    <div>
      <h1>Contact</h1>
      <p class="lede">For a trip, use Book now. For a general question, send the inquiry form.</p>
      <p>
        Phone: <a href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a><br />
        Fax: {site.fax}
      </p>
      <p>
        {
          site.addressLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </p>
      <p class="draft-note">These contact details are source-listed and pending reconfirmation.</p>
    </div>
    <div class="card">
      <h2>General inquiry</h2>
      <ContactForm client:load sourcePage="/contact" />
    </div>
  </section>
</BaseLayout>
