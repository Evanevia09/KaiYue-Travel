---
import PageHero from "../components/content/PageHero.astro";
import FeatureIcon from "../components/content/FeatureIcon.astro";
import { ContactForm } from "../components/content/ContactForm.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site.ts";
---

<BaseLayout title="Contact" description="Send a general inquiry to Kai Yue Travel Group Limited.">
  <PageHero
    eyebrow="Contact"
    title="Talk with the team"
    lede="Ask a general question or tell us about a business programme. For a single chauffeur journey, choose the relevant service from the menu."
  >
    <div slot="inquiry" class="card" id="inquiry">
      <h2>Send an inquiry</h2>
      <ContactForm client:load sourcePage="/contact" />
    </div>
  </PageHero>
  <section class="section" aria-labelledby="contact-details">
    <div class="wrap editorial-split">
      <div class="editorial-photo">
        <img
          src="/images/hero-home.jpg"
          width="1024"
          height="576"
          loading="lazy"
          alt="Chauffeur greeting guests beside a vehicle in Macau"
        /><span class="editorial-photo__label">Here to help</span>
      </div>
      <div class="editorial-copy">
        <p class="kicker">Reach us</p><h2 id="contact-details">A conversation starts here</h2>
        <div class="feature-lines">
          <div>
            <span class="icon-frame"><FeatureIcon name="message" /></span><p>
              <strong>General enquiries</strong><br /><a
                href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a
              >
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="building" /></span><p>
              <strong>Macau office</strong><br />{site.addressLines.join(", ")}
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="car" /></span><p>
              <strong>Business programmes</strong><br />For corporate, hotel, and agency needs, use
              the <a href="/corporate">Business pages</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
