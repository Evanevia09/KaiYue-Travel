---
import { BookingPage } from "../components/booking/BookingPage.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Request a chauffeur"
  description="Fallback booking page using the same form as the homepage widget."
>
  <PageHero
    eyebrow="Book"
    title="Request a chauffeur"
    lede="Use this page if the mobile sheet or homepage widget is unavailable. The fields and rules are the same."
  />
  <section class="section">
    <div class="wrap booking-page">
      <div class="booking-card">
        <div class="booking-card__header">
          <div>
            <h2>Request a chauffeur</h2>
            <p>Quote after review · Human confirmation</p>
          </div>
        </div>
        <div class="booking-card__body">
          <BookingPage client:load sourcePage="/booking" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
