---
import { BookingPage } from "../components/booking/BookingPage.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Request a chauffeur"
  description="Fallback booking page using the same form as the homepage widget."
>
  <section class="wrap section">
    <h1>Request a chauffeur</h1>
    <p class="lede">
      Use this page if the mobile sheet or homepage widget is unavailable. The fields and rules are
      the same.
    </p>
    <div class="booking-card">
      <div class="booking-card__header">
        <span class="booking-card__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.8"
            ></rect>
            <path d="M3 10h18" stroke="currentColor" stroke-width="1.8"></path>
            <path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
            ></path>
          </svg>
        </span>
        <div>
          <h2>Book Your Journey</h2>
          <p>Fast. Easy. Reliable.</p>
        </div>
      </div>
      <div class="booking-card__body">
        <BookingPage client:load sourcePage="/booking" />
      </div>
    </div>
  </section>
</BaseLayout>
