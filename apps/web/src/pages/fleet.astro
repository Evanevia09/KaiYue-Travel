---
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Fleet"
  description="Request a premium private vehicle. Specific models are confirmed after review."
>
  <PageHero
    eyebrow="Our fleet"
    title="Comfort confirmed after review"
    lede="Vehicle assignment is confirmed after we review your request. This page does not publish unverified model counts, seat specifications, or availability claims."
  >
    <BookingLauncher slot="actions" client:load sourcePage="/fleet" sourceTrigger="fleet-hero" />
  </PageHero>
</BaseLayout>
