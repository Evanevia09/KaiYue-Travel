---
import { BookingLauncher } from "../../components/booking/BookingLauncher.tsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../lib/site.ts";
---

<BaseLayout
  title="Services"
  description="Airport, hotel, point-to-point, hourly, sightseeing, and corporate chauffeur requests."
>
  <section class="wrap page-hero section">
    <h1>Services</h1>
    <p class="lede">
      Choose the request type that fits. Every option uses the same booking form and the same human
      confirmation step.
    </p>
    <div class="grid-2">
      {
        services.map((service) => (
          <article class="card">
            <h2>
              <a href={`/services/${service.slug}`}>{service.title}</a>
            </h2>
            <p>{service.summary}</p>
            <BookingLauncher
              client:load
              sourcePage="/services"
              sourceTrigger={service.slug}
              serviceType={service.serviceType}
              label={`Book ${service.title.toLowerCase()}`}
            />
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
