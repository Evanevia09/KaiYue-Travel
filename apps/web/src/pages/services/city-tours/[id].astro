---
import { getCollection } from "astro:content";
import TourPackagePage from "../../../components/content/TourPackagePage.astro";

export async function getStaticPaths() {
  return (await getCollection("cityTours", ({ data }) => data.status !== "hidden")).map(
    (entry) => ({ params: { id: entry.id }, props: { entry } }),
  );
}
const { entry } = Astro.props;
---

<TourPackagePage entry={entry} />
