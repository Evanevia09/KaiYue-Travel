---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms"
  description="Draft terms. Cancellation and service terms require owner approval."
>
  <article class="wrap section">
    <h1>Terms</h1>
    <p class="draft-note">Draft only. Not approved legal text.</p>
    <p>
      Submitting a request does not create a confirmed transport contract. Confirmation, pricing,
      and payment method are communicated by the team after review.
    </p>
    <p>Cancellation and notice rules will be published after business approval.</p>
  </article>
</BaseLayout>
