---
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="FAQ" description="How chauffeur requests, confirmation, and quotes work.">
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    lede="How chauffeur requests, confirmation, and quotes work."
  >
    <BookingLauncher slot="actions" client:load sourcePage="/faq" sourceTrigger="faq-hero" />
  </PageHero>
</BaseLayout>
