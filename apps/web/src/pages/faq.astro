---
import { BookingLauncher } from "../components/booking/BookingLauncher.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs } from "../lib/site.ts";
---

<BaseLayout title="FAQ" description="How chauffeur requests, confirmation, and quotes work.">
  <PageHero
    eyebrow="FAQ"
    title="Frequently asked questions"
    lede="How chauffeur requests, confirmation, and quotes work."
  />
  <section class="section">
    <div class="wrap">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
      <p style="margin-top: 2rem;">
        <BookingLauncher client:load sourcePage="/faq" sourceTrigger="faq-cta" />
      </p>
    </div>
  </section>
</BaseLayout>
