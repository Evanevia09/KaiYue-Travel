---
export const prerender = false;
import { BookingEmbedded } from "../components/booking/BookingEmbedded.tsx";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localeFromPath, localePath } from "../lib/i18n.ts";
import { listPublicOffers } from "../lib/server/offers/service.ts";
import { specialOfferUi } from "../lib/special-offer-copy.ts";
import { env } from "cloudflare:workers";

Astro.response.headers.set("Cache-Control", "private, no-store, no-cache, must-revalidate");
Astro.response.headers.set("CDN-Cache-Control", "no-store");
Astro.response.headers.set("Cloudflare-CDN-Cache-Control", "no-store");

const locale = localeFromPath(Astro.url.pathname);
const copy = specialOfferUi(locale);

let items: Awaited<ReturnType<typeof listPublicOffers>>["items"] = [];
try {
  items = (await listPublicOffers(env)).items;
} catch {
  items = [];
}
const widgetOffers = items.map((item) => ({ id: item.id, title: item.title }));
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  bookingEnabled={true}
  showMobileBook={false}
  specialOffers={widgetOffers}
>
  <PageHero
    className="hero--city-tours"
    eyebrow={copy.heroEyebrow}
    title={copy.heroTitle}
    lede={copy.heroLede}
    imageSrc="/images/illustrative/city-tours-hero.jpg"
    imageAlt="Illustrative scene of a private car with visitors in Macau."
  >
    <BookingEmbedded
      slot="booking"
      client:only="react"
      sourcePage={Astro.url.pathname}
      enquiryKind="special_offer"
    />
  </PageHero>
  <section class="section page-offers" aria-labelledby="special-offers-title" data-no-localize>
    <div class="wrap">
      <p class="kicker">{copy.kicker}</p>
      <h2 id="special-offers-title">{copy.heading}</h2>
      <p class="lede">{copy.lede}</p>
      {
        items.length === 0 ? (
          <p class="muted">{copy.empty}</p>
        ) : (
          <div class="home-tour-grid">
            {items.map((item, index) => (
              <article class="home-tour-card">
                {item.mainPhotoUrl && (
                  <a
                    class="home-tour-card__media"
                    href={localePath(`/special-offers/${item.id}`, locale)}
                  >
                    <img
                      src={item.mainPhotoThumbUrl ?? item.mainPhotoUrl}
                      srcset={
                        item.mainPhotoThumbUrl
                          ? `${item.mainPhotoThumbUrl} 480w, ${item.mainPhotoUrl} 1600w`
                          : undefined
                      }
                      sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"
                      alt=""
                      width={item.mainPhotoWidth ?? 1600}
                      height={item.mainPhotoHeight ?? 1104}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={index === 0 ? "high" : "low"}
                    />
                  </a>
                )}
                <div class="home-tour-card__body">
                  <h3>
                    <a href={localePath(`/special-offers/${item.id}`, locale)}>{item.title}</a>
                  </h3>
                  <p>{item.description}</p>
                  {item.priceFrom != null && (
                    <p class="home-tour-card__fact">
                      {copy.from} {item.priceFrom}
                    </p>
                  )}
                  {item.terms && (
                    <p>
                      <strong>{copy.terms}.</strong> {item.terms}
                    </p>
                  )}
                  <p>
                    <a
                      class="btn btn--primary"
                      href={localePath(`/special-offers/${item.id}`, locale)}
                    >
                      {copy.book}
                    </a>
                  </p>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  :global(.hero--city-tours) {
    min-height: 76svh;
  }
  :global(.hero--city-tours .hero__bg img) {
    object-position: center 42%;
  }
  .page-offers {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }
  .page-offers h2 {
    margin: 0 0 0.75rem;
  }
  .home-tour-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .home-tour-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #e2e2e5;
    border-radius: 1.2rem;
    background: #fff;
    box-shadow: 0 18px 40px rgb(0 0 0 / 6%);
  }
  .home-tour-card__media {
    display: block;
    aspect-ratio: 1.45;
    overflow: hidden;
    background: #e8e8e8;
  }
  .home-tour-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-tour-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.35rem 1.4rem 1.45rem;
  }
  .home-tour-card h3 {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.25;
  }
  .home-tour-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .home-tour-card h3 a:hover,
  .home-tour-card h3 a:focus-visible {
    color: var(--color-accent-strong);
  }
  @media (max-width: 1000px) {
    .home-tour-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .home-tour-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.hero--city-tours) {
      min-height: 72svh;
    }
  }
</style>
