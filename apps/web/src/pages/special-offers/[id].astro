---
export const prerender = false;
import SpecialOfferPage from "../../components/content/SpecialOfferPage.astro";
import { listPublicOffers } from "../../lib/server/offers/service.ts";
import { env } from "cloudflare:workers";

Astro.response.headers.set("Cache-Control", "private, no-store, no-cache, must-revalidate");
Astro.response.headers.set("CDN-Cache-Control", "no-store");
Astro.response.headers.set("Cloudflare-CDN-Cache-Control", "no-store");

const id = Astro.params.id;
let items: Awaited<ReturnType<typeof listPublicOffers>>["items"] = [];
try {
  items = (await listPublicOffers(env)).items;
} catch {
  items = [];
}
const item = id ? items.find((offer) => offer.id === id) : undefined;
if (!item) {
  return Astro.rewrite("/404");
}

const photos = item.photos
  .map((photo) => ({
    id: photo.id,
    url: photo.url,
    thumbUrl: photo.thumbUrl,
    isMain: photo.isMain,
    width: photo.width,
    height: photo.height,
  }))
  .sort((a, b) => Number(b.isMain) - Number(a.isMain));
if (photos.length === 0) {
  return Astro.rewrite("/404");
}
---

<SpecialOfferPage
  publishedOffers={items.map((offer) => ({ id: offer.id, title: offer.title }))}
  offer={{
    id: item.id,
    title: item.title,
    description: item.description,
    priceFrom: item.priceFrom,
    terms: item.terms,
    photos,
    mainPhotoUrl: item.mainPhotoUrl,
  }}
/>
