---
export const prerender = false;
import { env } from "cloudflare:workers";
import { ProfileSettings } from "../../components/admin/ProfileSettings.tsx";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { adminLocaleFromCookies } from "../../lib/admin-i18n.ts";
import { passwordAdminAllowed } from "../../lib/server/admin-gate.ts";
import { requireAdmin } from "../../lib/server/auth.ts";

const locale = adminLocaleFromCookies(Astro.cookies);
const actor = await requireAdmin(Astro.request, env);
const passwordChangeAvailable = passwordAdminAllowed(env, Astro.request);
---

<AdminLayout titleKey="title.settings" locale={locale}>
  <ProfileSettings
    client:load
    locale={locale}
    email={actor.email}
    passwordChangeAvailable={passwordChangeAvailable}
  />
</AdminLayout>
