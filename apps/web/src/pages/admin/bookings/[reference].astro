---
export const prerender = false;
import { BookingDetailPanel } from "../../../components/admin/BookingDetailPanel.tsx";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { adminLocaleFromCookies, t } from "../../../lib/admin-i18n.ts";

const locale = adminLocaleFromCookies(Astro.cookies);
const reference = Astro.params.reference ?? "";
---

<AdminLayout titleKey="title.bookingDetail" titleVars={{ reference }} locale={locale}>
  <p><a href="/admin/bookings">{t(locale, "detail.astroBack")}</a></p>
  <BookingDetailPanel client:load locale={locale} reference={reference} />
</AdminLayout>
