---
export const prerender = false;
import { OffersPanel, type AdminOffer } from "../../components/admin/OffersPanel.tsx";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listAdminOffers } from "../../lib/server/offers/service.ts";
import { env } from "cloudflare:workers";

let items: AdminOffer[] | null = null;
try {
  items = (await listAdminOffers(env)).items;
} catch {
  items = null;
}
---

<AdminLayout title="Special Offers"><OffersPanel client:load initialItems={items} /></AdminLayout>
