---
export const prerender = false;
import { ContactDetailPanel } from "../../../components/admin/ContactDetailPanel.tsx";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { adminLocaleFromCookies, t } from "../../../lib/admin-i18n.ts";

const locale = adminLocaleFromCookies(Astro.cookies);
const id = Astro.params.id ?? "";
---

<AdminLayout titleKey="title.inquiry" locale={locale}>
  <p><a href="/admin/contacts">{t(locale, "contacts.back")}</a></p>
  <ContactDetailPanel client:load locale={locale} id={id} />
</AdminLayout>
