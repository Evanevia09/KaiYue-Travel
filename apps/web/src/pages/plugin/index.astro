---
import BaseLayout from "../../layouts/BaseLayout.astro";
import guide from "@kaiyue/agent-tools/guide";

const isStaging = Astro.site?.hostname === "staging.kaiyuemacau.com";
const adminOrigin = "https://admin-staging.kaiyuemacau.com";
const endpoint = `${adminOrigin}/api/v1/admin/mcp`;
---

<BaseLayout title="Kai Yue Travel agent tools" noindex={true} showMobileBook={false}>
  <section class="section page-content" aria-labelledby="plugin-title">
    <div class="wrap page-content__narrow">
      <h1 id="plugin-title">Kai Yue Travel agent tools</h1>
      <p class="lede">
        Connect a staff agent to review bookings, assign drivers and vehicles, and prepare
        quotations.
      </p>
      {
        isStaging && (
          <>
            <h2>Connect on staging</h2>
            <ol>
              <li>
                Add <code>{endpoint}</code> to your MCP client using Streamable HTTP and OAuth.
              </li>
              <li>
                When the client opens your browser, sign in to staging admin and authorize the
                client.
              </li>
              <li>
                Your client renews its access automatically during the authorized staff session.
              </li>
            </ol>
            <p>
              Clients with manual bearer-token setup can use
              <a href={`${adminOrigin}/admin/agent-connect`}>a short-lived connection token</a>.
            </p>
            <p>
              The agent receives the tool list when connected. Follow any review link it returns
              when an action needs approval.
            </p>
          </>
        )
      }
      <p><a href="/plugin/capabilities.json">Agent instructions and capability list (JSON)</a></p>
      <h2>Available tools</h2>
      <dl>
        {
          guide.tools.map(({ title, description }) => (
            <>
              <>
                <dt>{title}</dt>
                <dd>{description}</dd>
              </>
            </>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
