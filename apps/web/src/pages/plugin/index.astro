---
import BaseLayout from "../../layouts/BaseLayout.astro";
import guide from "@kaiyue/agent-tools/guide";
import { STAGING_MCP_ENDPOINT, STAGING_MCP_SESSION } from "../../lib/staging-mcp-connect.ts";

const isStaging = Astro.site?.hostname === "staging.kaiyuemacau.com";
---

<BaseLayout title="Kai Yue Travel agent tools" noindex={true} showMobileBook={false}>
  <section class="section page-content" aria-labelledby="plugin-title">
    <div class="wrap page-content__narrow">
      <h1 id="plugin-title">Kai Yue Travel agent tools</h1>
      <p class="lede">
        Connect a staff agent to review bookings, assign drivers and vehicles, and prepare
        quotations.
      </p>
      {
        isStaging && (
          <>
            <h2>Connect on staging</h2>
            <ol>
              <li>
                Use the existing staff or super_admin email and password. Prefer a login already
                saved in the agent vault. If none is saved, collect email and password in a secure
                in-chat form. Do not open the admin sign-in page.
              </li>
              <li>
                POST JSON <code>{`{ "email", "password" }`}</code> to
                <code>{STAGING_MCP_SESSION}</code>. Do not put the password in the URL.
              </li>
              <li>
                Add <code>{STAGING_MCP_ENDPOINT}</code> to your MCP client using Streamable HTTP.
                Enter the returned token in the secure bearer-token setting. The connection has that
                account’s normal permissions.
              </li>
            </ol>
            <p>
              The agent will receive the tool list on connection. Follow any review link it returns
              when an action needs approval. Write tools still need browser approval.
            </p>
          </>
        )
      }
      <p><a href="/plugin/capabilities.json">Agent instructions and capability list (JSON)</a></p>
      <h2>Available tools</h2>
      <dl>
        {
          guide.tools.map(({ title, description }) => (
            <>
              <>
                <dt>{title}</dt>
                <dd>{description}</dd>
              </>
            </>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
