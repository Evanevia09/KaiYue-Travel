---
import JsonLd from "../../components/content/JsonLd.astro";
import BusinessInquiry from "../../components/content/BusinessInquiry.astro";
import FeatureIcon from "../../components/content/FeatureIcon.astro";
import PageHero from "../../components/content/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { business, organizationJsonLd, telHref } from "../../lib/business.ts";
import { site } from "../../lib/site.ts";

const path = "/business/travel-agency";
const origin = Astro.site ?? site.url;
const pageUrl = new URL(path, origin).toString();
---

<BaseLayout
  title="Travel agency partner programmes"
  description="Travel agencies can arrange Macau and Greater Bay Area guest mobility with Kai Yue Travel Group Limited: dual-plate Alphard capacity, 7×24 dispatch, and customized itineraries."
>
  <JsonLd slot="head" data={organizationJsonLd(pageUrl)} />
  <PageHero
    eyebrow="Business"
    title="Travel agency programmes"
    imageSrc="/images/illustrative/travel-agency-hero.jpg"
    imageAlt="Illustrative travelers welcomed by a coordinator and chauffeur beside a private vehicle"
    lede={`${site.legalName} works with inbound and local agencies on guest chauffeur movements, customized itineraries, and Macau–Mainland dual-plate transfers. ${business.allianceLine}.`}
  >
    <BusinessInquiry slot="inquiry" sourcePage={path} heading="Send an agency inquiry" />
  </PageHero>
  <section class="section" aria-labelledby="agency-journeys">
    <div class="wrap editorial-split">
      <div class="editorial-photo">
        <img
          src="/images/illustrative/travel-agency-feature.jpg"
          width="1024"
          height="576"
          loading="lazy"
          alt="Illustrative agency coordinator reviewing an itinerary with travelers beside a private vehicle"
        />
      </div>
      <div class="editorial-copy">
        <p class="kicker">For travel partners</p><h2 id="agency-journeys">
          Guest movements to plan together
        </h2>
        <p class="lede">
          Kai Yue Travel Group works with Mingmen Tourism and Mingmen Technology to coordinate
          premium guest transport. Agency programmes can bring together Macau arrivals, tailored
          itineraries, and reviewed Macau–Mainland connections.
        </p>
        <div class="feature-lines">
          <div>
            <span class="icon-frame"><FeatureIcon name="car" /></span><p>
              <strong>Arrival and departure</strong><br />Plan airport, checkpoint, and hotel
              transfers around arrival times, meeting points, and luggage needs.
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="calendar" /></span><p>
              <strong>Custom itineraries</strong><br />Combine Macau stops, guest reception, and
              event movements in a proposed schedule for review.
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="route" /></span><p>
              <strong>Regional connections</strong><br />Discuss dual-plate journeys to Zhuhai,
              Guangzhou, Shenzhen, Zhongshan, or Jiangmen, subject to route and vehicle review.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--muted" aria-labelledby="agency-process">
    <div class="wrap">
      <div class="section-intro">
        <div>
          <p class="kicker">Next steps</p><h2 id="agency-process">Start with the itinerary</h2>
        </div><p>
          The group portfolio describes 200+ Alphard 40 Series vehicles and 7×24 dispatch for
          business programmes. Vehicle assignment and each itinerary still require review.
        </p>
      </div>
      <div class="process-grid process-grid--light">
        <article>
          <span class="icon-frame"><FeatureIcon name="calendar" /></span><span
            class="process-grid__number">01</span
          ><h3>Dates and pickup</h3><p>Share travel dates, timing, and pickup points.</p>
        </article>
        <article>
          <span class="icon-frame"><FeatureIcon name="car" /></span><span
            class="process-grid__number">02</span
          ><h3>Guest needs</h3><p>Include passenger volume and luggage requirements.</p>
        </article>
        <article>
          <span class="icon-frame"><FeatureIcon name="route" /></span><span
            class="process-grid__number">03</span
          ><h3>Route review</h3><p>Describe Macau-only or Macau–Mainland movements.</p>
        </article>
      </div>
      <p class="business-contact">
        For an agency programme, call <a href={telHref(site.businessPhones[0])}
          >{site.businessPhones[0]}</a
        > or use the inquiry form above. A coordinator will follow up on timing, capacity, and route feasibility.
      </p>
    </div>
  </section>
</BaseLayout>
