---
import JsonLd from "../../components/content/JsonLd.astro";
import BusinessInquiry from "../../components/content/BusinessInquiry.astro";
import FeatureIcon from "../../components/content/FeatureIcon.astro";
import PageHero from "../../components/content/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { business, organizationJsonLd, telHref } from "../../lib/business.ts";
import { site } from "../../lib/site.ts";

const path = "/business/hotels-resorts";
const origin = Astro.site ?? site.url;
const pageUrl = new URL(path, origin).toString();
---

<BaseLayout
  title="Hotel and resort chauffeur programmes"
  description="Hotels and resorts can arrange guest airport, hotel, and Macau–Mainland dual-plate Alphard transfers with Kai Yue Travel Group Limited. 7×24 dispatch and licensed capacity."
>
  <JsonLd slot="head" data={organizationJsonLd(pageUrl)} />
  <PageHero
    eyebrow="Business"
    title="Hotel and resort programmes"
    imageSrc="/images/illustrative/hotels-resorts-hero.jpg"
    imageAlt="Illustrative hotel guests welcomed by a chauffeur beside a private vehicle"
    lede={`${site.legalName} is ${business.venetian}. Properties can request guest airport, inter-hotel, and Greater Bay Area dual-plate transfers with 7×24 dispatch.`}
  >
    <BusinessInquiry slot="inquiry" sourcePage={path} heading="Send a property inquiry" />
  </PageHero>
  <section class="section" aria-labelledby="hotel-journeys">
    <div class="wrap editorial-split">
      <div class="editorial-photo">
        <img
          src="/images/illustrative/hotels-resorts-feature.jpg"
          width="1024"
          height="576"
          loading="lazy"
          alt="Illustrative hotel coordinator discussing guest arrivals with a chauffeur beside a private vehicle"
        />
      </div>
      <div class="editorial-copy">
        <p class="kicker">For hospitality teams</p><h2 id="hotel-journeys">
          Guest journeys to coordinate
        </h2>
        <p class="lede">
          Property teams can discuss a recurring guest transport programme or a defined event. Kai
          Yue Travel Group brings the group portfolio's premium vehicle capacity together with
          Mingmen Tourism's 7×24 dispatch operation.
        </p>
        <div class="feature-lines">
          <div>
            <span class="icon-frame"><FeatureIcon name="car" /></span><p>
              <strong>Airport and checkpoint arrivals</strong><br />Share flight or crossing times,
              meeting points, guest count, and luggage needs.
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="building" /></span><p>
              <strong>Hotel and event movements</strong><br />Plan inter-hotel transfers, executive
              reception, and timed journeys to meetings or venues.
            </p>
          </div>
          <div>
            <span class="icon-frame"><FeatureIcon name="route" /></span><p>
              <strong>Regional transfers</strong><br />Discuss dual-plate Macau–Mainland journeys
              for guests, subject to route and vehicle review.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--muted" aria-labelledby="hotel-process">
    <div class="wrap">
      <div class="section-intro">
        <div>
          <p class="kicker">Working together</p><h2 id="hotel-process">
            A programme shaped around the property
          </h2>
        </div><p>
          The group portfolio describes 200+ Alphard 40 Series vehicles, including cross-border
          capacity. A coordinator confirms the available vehicle, route, and service terms for each
          property programme.
        </p>
      </div>
      <div class="process-grid process-grid--light">
        <article>
          <span class="icon-frame"><FeatureIcon name="building" /></span><span
            class="process-grid__number">01</span
          ><h3>Property details</h3><p>Tell us who is coordinating and where guests will be met.</p>
        </article>
        <article>
          <span class="icon-frame"><FeatureIcon name="calendar" /></span><span
            class="process-grid__number">02</span
          ><h3>Expected demand</h3><p>Share dates, frequency, and approximate guest volumes.</p>
        </article>
        <article>
          <span class="icon-frame"><FeatureIcon name="route" /></span><span
            class="process-grid__number">03</span
          ><h3>Journey types</h3><p>Outline arrival, local, or cross-border movements.</p>
        </article>
      </div>
      <p class="business-contact">
        Discuss a property programme at <a href={telHref(site.businessPhones[0])}
          >{site.businessPhones[0]}</a
        > or send an inquiry above. The form does not confirm a guest transfer or reserve a vehicle.
      </p>
    </div>
  </section>
</BaseLayout>
