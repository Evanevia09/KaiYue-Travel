---
export const prerender = false;
import { env } from "cloudflare:workers";
import { AdminLocaleSwitch } from "../components/admin/AdminLocaleSwitch.tsx";
import { SetupForm } from "../components/admin/SetupForm.tsx";
import { adminLocaleFromCookies, t } from "../lib/admin-i18n.ts";
import "../styles/global.css";

const locale = adminLocaleFromCookies(Astro.cookies);
if (env.ENVIRONMENT !== "development") {
  return new Response(t(locale, "setup.disabled"), {
    status: 403,
    headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" },
  });
}
const htmlLang = locale === "zh-Hant" ? "zh-Hant" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex, nofollow" /><link
      rel="icon"
      href="/favicon.ico"
      sizes="any"
    /><link rel="icon" href="/images/mark.svg" type="image/svg+xml" /><title>
      {t(locale, "title.setup")}
    </title></head
  ><body class="admin-login-page"
    ><main class="admin-login-card">
      <div class="admin-login-toolbar">
        <a class="admin-login-brand" href="/"
          >Kai Yue <span>{t(locale, "brand.operations")}</span></a
        >
        <AdminLocaleSwitch client:load locale={locale} />
      </div><p class="admin-eyebrow">
        {t(locale, "setup.eyebrow")}
      </p><h1>{t(locale, "setup.heading")}</h1><p class="muted">
        {t(locale, "setup.help")}
      </p><SetupForm client:load locale={locale} /><p>
        <a href="/login">{t(locale, "setup.back")}</a>
      </p>
    </main></body
  >
</html>
