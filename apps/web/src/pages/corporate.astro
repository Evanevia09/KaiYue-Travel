---
import PageHero from "../components/content/PageHero.astro";
import { ContactForm } from "../components/content/ContactForm.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Corporate solution"
  description="Send a corporate chauffeur inquiry for guest and executive movements in Macau."
>
  <PageHero
    eyebrow="Business"
    title="Corporate solution"
    lede="For companies arranging executive and guest chauffeur movements in Macau. This is an inquiry path, not a contracted service level or guaranteed response time."
  >
    <a slot="actions" class="btn btn--primary" href="#inquiry">Send an inquiry</a>
  </PageHero>
  <section class="section">
    <div class="wrap grid-2">
      <div>
        <h2>How we can help</h2>
        <ul>
          <li>Guest airport and hotel movements</li>
          <li>Executive travel programmes</li>
          <li>Event-day transport coordination requests</li>
        </ul>
        <p>Include expected dates, passenger volume, and whether the need is one-off or recurring.</p>
      </div>
      <div class="card" id="inquiry">
        <h2>Send an inquiry</h2>
        <ContactForm client:load sourcePage="/corporate" defaultType="corporate" />
      </div>
    </div>
  </section>
</BaseLayout>
