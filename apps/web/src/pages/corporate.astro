---
import JsonLd from "../components/content/JsonLd.astro";
import BusinessInquiry from "../components/content/BusinessInquiry.astro";
import FeatureIcon from "../components/content/FeatureIcon.astro";
import PageHero from "../components/content/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allianceMembers,
  business,
  corporateScenarios,
  organizationJsonLd,
  telHref,
} from "../lib/business.ts";
import { site } from "../lib/site.ts";

const path = "/corporate";
const origin = Astro.site ?? site.url;
const pageUrl = new URL(path, origin).toString();
---

<BaseLayout
  title="Corporate solution"
  description="Kai Yue Group Limited provides one-stop, customized, compliant corporate mobility across Macau and the Greater Bay Area, with dual-plate Toyota Alphard 40 Series vehicles and 7×24 dispatch."
>
  <JsonLd slot="head" data={organizationJsonLd(pageUrl)} />
  <PageHero
    eyebrow="Business"
    title={business.headline}
    imageSrc="/images/illustrative/corporate-solutions-hero.jpg"
    imageAlt="Illustrative business travelers welcomed by a chauffeur beside a private vehicle"
    lede={`${site.groupLegalName} (${site.groupLegalNameZh}) is built with Mingmen Tourism and Mingmen Technology: compliant capacity, professional dispatch, and an intelligent platform for Macau–Mainland luxury-car programmes.`}
  >
    <BusinessInquiry slot="inquiry" sourcePage={path} />
  </PageHero>
  <section class="section" aria-labelledby="corporate-programmes">
    <div class="wrap editorial-split">
      <div class="editorial-photo">
        <img
          src="/images/illustrative/corporate-solutions-feature.jpg"
          width="860"
          height="400"
          loading="lazy"
          alt="Illustrative corporate coordinator reviewing a transport schedule beside a private vehicle"
        />
      </div>
      <div class="editorial-copy">
        <p class="kicker">Corporate mobility</p><h2 id="corporate-programmes">
          Programmes for business travel
        </h2>
        <p class="lede">
          From a named executive car to a multi-vehicle event, the programme is shaped around the
          itinerary, passenger group, and operating area. The group portfolio describes more than
          200 Toyota Alphard 40 Series vehicles, including dual-plate capacity for Macau–Mainland
          journeys; specific vehicles and routes are confirmed during review.
        </p>
        <div class="feature-lines">
          {
            corporateScenarios.map((scenario, index) => (
              <div>
                <span class="icon-frame">
                  <FeatureIcon name={index === 0 ? "car" : index === 1 ? "route" : "calendar"} />
                </span>
                <div class="feature-lines__copy">
                  <h3>{scenario.title}</h3>
                  <p>
                    {scenario.audience}. {scenario.points[0]}.
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="section section--muted" aria-labelledby="corporate-alliance">
    <div class="wrap">
      <div class="section-intro">
        <div>
          <p class="kicker">The group approach</p><h2 id="corporate-alliance">
            Travel, operations, and technology
          </h2>
        </div><p>
          Kai Yue Travel Group provides the transport capacity, Mingmen Tourism coordinates 7×24
          dispatch, and Mingmen Technology supports the One-Click Travel operations platform.
        </p>
      </div>
      <p class="business-background">
        Kai Yue Travel Group Limited began in Macau in 2009 as Zhaoxin International Travel Limited
        and adopted its current name in 2024. The group portfolio describes a Macau headquarters and
        a Hengqin branch supporting its Macau–Mainland business.
      </p>
      <div class="process-grid process-grid--light">
        {
          allianceMembers.map((member, index) => (
            <article>
              <>
                <span class="icon-frame">
                  <FeatureIcon name={index === 0 ? "building" : index === 1 ? "car" : "spark"} />
                </span>
                <span class="process-grid__number">0{index + 1}</span>
              </>
              <h3>{member.name}</h3>
              <p>
                <strong>{member.role}.</strong> {member.summary}
              </p>
            </article>
          ))
        }
      </div>
      <p class="business-contact">
        Discuss a corporate programme with the business team at <a
          href={telHref(site.businessPhones[0])}>{site.businessPhones[0]}</a
        >. This form starts an inquiry; a person reviews scope and availability before confirming an
        arrangement.
      </p>
    </div>
  </section>
</BaseLayout>
