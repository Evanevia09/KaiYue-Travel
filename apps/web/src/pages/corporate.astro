---
import { ContactForm } from "../components/content/ContactForm.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Corporate travel"
  description="Send a corporate or hotel transport inquiry for guest and executive movements."
>
  <section class="wrap section grid-2">
    <div>
      <h1>Corporate and partner inquiries</h1>
      <p class="lede">
        For companies, hotels, and event coordinators who need more than a single trip. This is an
        inquiry path, not a contracted service level or guaranteed response time.
      </p>
      <ul>
        <li>Guest airport and hotel movements</li>
        <li>Executive travel programmes</li>
        <li>Event-day transport coordination requests</li>
      </ul>
      <p>Include expected dates, passenger volume, and whether the need is one-off or recurring.</p>
    </div>
    <div class="card">
      <h2>Send an inquiry</h2>
      <ContactForm client:load sourcePage="/corporate" defaultType="corporate" />
    </div>
  </section>
</BaseLayout>
